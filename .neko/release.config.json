{
  "schemaVersion": 2,
  "units": [
    {
      "id": "cli",
      "displayName": "neko-cli",
      "paths": [
        "**"
      ],
      "workingDirectory": ".",
      "tagPrefix": "v",
      "executor": {
        "type": "goreleaser",
        "delivery": "github-actions",
        "workflow": ".github/workflows/release-neko-cli.yml"
      }
    },
    {
      "id": "plugin-release",
      "displayName": "neko-cli release plugin",
      "paths": [
        "plugin/release/**",
        "docs/release/**",
        "docs/plugins/release.md"
      ],
      "workingDirectory": ".",
      "tagPrefix": "plugin-release/v",
      "executor": {
        "type": "goreleaser",
        "delivery": "github-actions",
        "workflow": ".github/workflows/release-plugin-release.yml"
      }
    },
    {
      "id": "plugin-ui",
      "displayName": "neko-cli ui plugin",
      "paths": [
        "plugin/ui/**",
        "docs/release/**",
        "docs/plugins/ui.md"
      ],
      "workingDirectory": ".",
      "tagPrefix": "plugin-ui/v",
      "executor": {
        "type": "goreleaser",
        "delivery": "github-actions",
        "workflow": ".github/workflows/release-plugin-ui.yml"
      }
    }
  ]
}
