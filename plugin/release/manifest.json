{
  "name": "release",
  "version": "4.1.1",
  "description": "Release management plugin",
  "author": "nekoman-hq",
  "commands": [
    {
      "name": "init",
      "description": "Initialize release system with project configuration",
      "outputs": [
        "text",
        "json"
      ],
      "flags": [
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "default": "cli",
          "description": "Release unit id"
        },
        {
          "name": "display-name",
          "type": "string",
          "required": false,
          "description": "Release unit display name"
        },
        {
          "name": "version",
          "type": "string",
          "required": false,
          "default": "0.1.0",
          "description": "Initial version (semver)"
        },
        {
          "name": "executor",
          "type": "string",
          "required": true,
          "description": "Release executor (goreleaser|jreleaser|release-it)"
        },
        {
          "name": "delivery",
          "type": "string",
          "required": true,
          "description": "Release delivery mode (local|github-actions)"
        },
        {
          "name": "workflow",
          "type": "string",
          "required": false,
          "description": "GitHub Actions workflow path, required for github-actions delivery"
        },
        {
          "name": "tag-prefix",
          "type": "string",
          "required": false,
          "default": "v",
          "description": "Release tag prefix"
        },
        {
          "name": "working-directory",
          "type": "string",
          "required": false,
          "default": ".",
          "description": "Unit working directory"
        },
        {
          "name": "paths",
          "type": "string",
          "required": false,
          "default": "**",
          "description": "Comma-separated unit path globs"
        },
        {
          "name": "kind",
          "type": "string",
          "required": false,
          "default": "release",
          "description": "Release unit kind (release|plugin)"
        },
        {
          "name": "plugin-name",
          "type": "string",
          "required": false,
          "description": "Public plugin name, required when kind=plugin"
        },
        {
          "name": "plugin-manifest",
          "type": "string",
          "required": false,
          "description": "Repository-root-relative plugin manifest path, required when kind=plugin"
        },
        {
          "name": "plugin-asset-prefix",
          "type": "string",
          "required": false,
          "description": "Plugin release asset prefix, required when kind=plugin and must match the unit id"
        },
        {
          "name": "plugin-binary-name",
          "type": "string",
          "required": false,
          "description": "Plugin executable name in release archives, required when kind=plugin"
        },
        {
          "name": "force",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Overwrite existing V2 config/state"
        }
      ]
    },
    {
      "name": "unit-add",
      "description": "Add a release unit to an existing V2 release configuration",
      "outputs": [
        "table",
        "json",
        "text"
      ],
      "flags": [
        {
          "name": "unit",
          "type": "string",
          "required": true,
          "description": "Release unit id to append"
        },
        {
          "name": "display-name",
          "type": "string",
          "required": false,
          "description": "Release unit display name"
        },
        {
          "name": "version",
          "type": "string",
          "required": false,
          "default": "0.1.0",
          "description": "Initial version (semver)"
        },
        {
          "name": "executor",
          "type": "string",
          "required": true,
          "description": "Release executor (goreleaser|jreleaser|release-it)"
        },
        {
          "name": "delivery",
          "type": "string",
          "required": true,
          "description": "Release delivery mode (local|github-actions)"
        },
        {
          "name": "workflow",
          "type": "string",
          "required": false,
          "description": "GitHub Actions workflow path, required for github-actions delivery"
        },
        {
          "name": "tag-prefix",
          "type": "string",
          "required": false,
          "default": "v",
          "description": "Release tag prefix"
        },
        {
          "name": "working-directory",
          "type": "string",
          "required": false,
          "default": ".",
          "description": "Unit working directory"
        },
        {
          "name": "paths",
          "type": "string",
          "required": false,
          "default": "**",
          "description": "Comma-separated unit path globs"
        },
        {
          "name": "kind",
          "type": "string",
          "required": false,
          "default": "release",
          "description": "Release unit kind (release|plugin)"
        },
        {
          "name": "plugin-name",
          "type": "string",
          "required": false,
          "description": "Public plugin name, required when kind=plugin"
        },
        {
          "name": "plugin-manifest",
          "type": "string",
          "required": false,
          "description": "Repository-root-relative plugin manifest path, required when kind=plugin"
        },
        {
          "name": "plugin-asset-prefix",
          "type": "string",
          "required": false,
          "description": "Plugin release asset prefix, required when kind=plugin and must match the unit id"
        },
        {
          "name": "plugin-binary-name",
          "type": "string",
          "required": false,
          "description": "Plugin executable name in release archives, required when kind=plugin"
        }
      ]
    },
    {
      "name": "init-options",
      "description": "Get available options for init command",
      "outputs": [
        "json"
      ]
    },
    {
      "name": "migrate",
      "description": "Safely migrate a root V1 release configuration to V2",
      "outputs": [
        "table",
        "json"
      ],
      "flags": [
        {
          "name": "dry-run",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Preview the migration without writing files"
        }
      ]
    },
    {
      "name": "patch",
      "description": "Create a patch release (x.y.Z)",
      "outputs": [
        "text",
        "json"
      ],
      "flags": [
        {
          "name": "dry-run",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Run without making changes"
        },
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit. Required when a V2 repository defines multiple units."
        }
      ]
    },
    {
      "name": "minor",
      "description": "Create a minor release (x.Y.0)",
      "outputs": [
        "text",
        "json"
      ],
      "flags": [
        {
          "name": "dry-run",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Run without making changes"
        },
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit. Required when a V2 repository defines multiple units."
        }
      ]
    },
    {
      "name": "major",
      "description": "Create a major release (X.0.0)",
      "outputs": [
        "text",
        "json"
      ],
      "flags": [
        {
          "name": "dry-run",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Run without making changes"
        },
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit. Required when a V2 repository defines multiple units."
        }
      ]
    },
    {
      "name": "resume",
      "description": "Resumes a previously journaled V2 GitHub Actions release. It never calculates a new version and does not automatically retry uncertain push or dispatch outcomes.",
      "outputs": [
        "table",
        "json"
      ],
      "flags": [
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit whose existing V2 GitHub Actions journal should be resumed."
        },
        {
          "name": "dry-run",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Assess the existing release journal without writing files, refs, journals, remotes, or dispatching."
        }
      ]
    },
    {
      "name": "history",
      "description": "Show release history",
      "outputs": [
        "table",
        "json"
      ],
      "flags": [
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit. Required when a V2 repository defines multiple units."
        }
      ]
    },
    {
      "name": "contributors",
      "description": "Show repository contributors",
      "outputs": [
        "table",
        "json"
      ],
      "flags": [
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit. Required when a V2 repository defines multiple units."
        }
      ]
    },
    {
      "name": "validate",
      "description": "Validate the release configuration",
      "outputs": [
        "table",
        "json"
      ],
      "flags": [
        {
          "name": "show",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Display current configuration details"
        },
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Selects the release unit. Required when a V2 repository defines multiple units."
        }
      ]
    },
    {
      "name": "plugin-index",
      "description": "Generate the public plugin registry index from V2 plugin units",
      "outputs": [
        "json",
        "table"
      ],
      "flags": [
        {
          "name": "output",
          "type": "string",
          "required": false,
          "description": "Optional file path to write plugin-index.json"
        },
        {
          "name": "check",
          "type": "bool",
          "required": false,
          "default": false,
          "description": "Validate that the plugin index can be generated without writing a file"
        },
        {
          "name": "pretty",
          "type": "bool",
          "required": false,
          "default": true,
          "description": "Pretty-print generated JSON"
        },
        {
          "name": "repository",
          "type": "string",
          "required": false,
          "default": "nekoman-hq/neko-cli",
          "description": "Repository identifier to include in the generated index"
        }
      ]
    }
  ],
  "renderer_types": [
    "table",
    "json",
    "text"
  ]
}
